# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored: credentials must never be committed.

# Your Databento API key, from https://databento.com (Account > API keys).
# Everything this project pulls is free under the course's Databento
# subscription. The pull script checks the cost before it downloads anything
# and refuses to proceed unless the cost is $0.00.
DATABENTO_API_KEY=""

# Your WRDS username, for the OptionMetrics pull in the single-name part. It
# authenticates without prompting once you have a .pgpass file, as in HW 1.
WRDS_USERNAME=""

# Optional: the window of the E-mini option settlement pull (YYYY-MM-DD).
# Defaults: the trailing 7 days, through today.
# START_DATE=
# END_DATE=

# Optional: override where pulled data and generated output are written.
# Leave these unset to use ./_data and ./_output.
# DATA_DIR=
# OUTPUT_DIR=
